<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>護理系專屬班網 - 實習與國考資訊站</title>
    
    <!-- 引入 Tailwind CSS 進行快速且響應式的排版 -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- 引入 FontAwesome 提供豐富的圖示 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- 引入 Google 字體提升閱讀體驗 -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- 自訂字體與平滑滾動效果 -->
    <style>
        html {
            scroll-behavior: smooth;
            font-family: 'Noto Sans TC', sans-serif;
        }
        /* 隱藏捲軸但保持可滾動的實用設定 */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;  /* IE and Edge */
            scrollbar-width: none;  /* Firefox */
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-teal-200">

    <!-- 固定式上方導覽列 -->
    <nav class="fixed w-full top-0 z-50 bg-teal-600 shadow-md transition-all duration-300" id="navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo / 網站標題 -->
                <div class="flex-shrink-0 flex items-center gap-2 cursor-pointer" onclick="window.scrollTo({top:0, behavior:'smooth'})">
                    <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-inner text-teal-600 text-xl">
                        <i class="fa-solid fa-staff-snake"></i>
                    </div>
                    <span class="font-bold text-xl text-white tracking-wide">護理系專屬班網</span>
                </div>
                
                <!-- 桌面版選單 -->
                <div class="hidden lg:flex space-x-6">
                    <a href="#news" class="text-teal-50 hover:text-white hover:bg-teal-500 px-3 py-2 rounded-md font-medium transition-colors">最新公告</a>
                    <a href="#internship" class="text-teal-50 hover:text-white hover:bg-teal-500 px-3 py-2 rounded-md font-medium transition-colors">實習專區</a>
                    <a href="#osce" class="text-teal-50 hover:text-white hover:bg-teal-500 px-3 py-2 rounded-md font-medium transition-colors">OSCE 檢核</a>
                    <a href="#terms" class="text-teal-50 hover:text-white hover:bg-teal-500 px-3 py-2 rounded-md font-medium transition-colors">縮寫速查</a>
                    <a href="#exam" class="text-teal-50 hover:text-white hover:bg-teal-500 px-3 py-2 rounded-md font-medium transition-colors">國考共筆</a>
                </div>
                
                <!-- 手機版選單按鈕 -->
                <div class="lg:hidden flex items-center">
                    <button id="mobile-menu-btn" class="text-teal-50 hover:text-white focus:outline-none p-2" aria-label="Toggle Menu">
                        <i class="fa-solid fa-bars text-2xl"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <!-- 手機版下拉選單 (預設隱藏) -->
        <div id="mobile-menu" class="hidden lg:hidden bg-teal-700 shadow-lg border-t border-teal-500">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                <a href="#news" class="block text-teal-50 hover:bg-teal-500 px-3 py-3 rounded-md text-base font-medium mobile-link"><i class="fa-solid fa-bullhorn w-6 text-center mr-2"></i> 最新公告</a>
                <a href="#internship" class="block text-teal-50 hover:bg-teal-500 px-3 py-3 rounded-md text-base font-medium mobile-link"><i class="fa-solid fa-user-nurse w-6 text-center mr-2"></i> 實習專區</a>
                <a href="#osce" class="block text-teal-50 hover:bg-teal-500 px-3 py-3 rounded-md text-base font-medium mobile-link"><i class="fa-solid fa-list-check w-6 text-center mr-2"></i> OSCE 檢核</a>
                <a href="#terms" class="block text-teal-50 hover:bg-teal-500 px-3 py-3 rounded-md text-base font-medium mobile-link"><i class="fa-solid fa-book-medical w-6 text-center mr-2"></i> 醫護縮寫速查</a>
                <a href="#exam" class="block text-teal-50 hover:bg-teal-500 px-3 py-3 rounded-md text-base font-medium mobile-link"><i class="fa-solid fa-graduation-cap w-6 text-center mr-2"></i> 國考共筆</a>
            </div>
        </div>
    </nav>

    <!-- 首頁視覺區 (Hero Section) -->
    <header class="pt-28 pb-16 px-4 relative overflow-hidden bg-gradient-to-br from-blue-50 via-teal-50 to-emerald-50 border-b border-teal-100">
        <div class="absolute top-10 left-10 text-teal-100 opacity-50 transform -rotate-12 select-none pointer-events-none">
            <i class="fa-solid fa-capsules text-9xl"></i>
        </div>
        <div class="absolute bottom-10 right-10 text-blue-100 opacity-50 transform rotate-12 select-none pointer-events-none">
            <i class="fa-solid fa-heart-pulse text-9xl"></i>
        </div>

        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-800 mb-4 leading-tight">
                歡迎來到<br class="md:hidden"><span class="text-teal-600">護理系專屬班網</span>
            </h1>
            <p class="text-base sm:text-lg md:text-xl text-slate-600 mb-10 font-medium">實習指引、OSCE技術、醫護術語與國考共筆，全方位護理學習平台！</p>
            
            <!-- 國考倒數計時器卡片 -->
            <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 border border-slate-100 max-w-2xl mx-auto transform transition hover:scale-[1.01] duration-300">
                <div class="flex items-center justify-center gap-3 mb-4">
                    <span class="flex items-center justify-center w-10 h-10 rounded-full bg-red-100 text-red-500">
                        <i class="fa-solid fa-stopwatch text-xl"></i>
                    </span>
                    <h2 class="text-xl sm:text-2xl font-bold text-slate-800">距離護理師國家考試</h2>
                </div>
                
                <div class="grid grid-cols-4 gap-2 md:gap-4 text-center">
                    <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 shadow-sm">
                        <div id="cd-days" class="text-2xl sm:text-4xl md:text-5xl font-mono font-bold text-teal-600">--</div>
                        <div class="text-xs md:text-sm text-slate-500 mt-1 font-medium">天 (Days)</div>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 shadow-sm">
                        <div id="cd-hours" class="text-2xl sm:text-4xl md:text-5xl font-mono font-bold text-blue-500">--</div>
                        <div class="text-xs md:text-sm text-slate-500 mt-1 font-medium">時 (Hours)</div>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 shadow-sm">
                        <div id="cd-minutes" class="text-2xl sm:text-4xl md:text-5xl font-mono font-bold text-blue-500">--</div>
                        <div class="text-xs md:text-sm text-slate-500 mt-1 font-medium">分 (Mins)</div>
                    </div>
                    <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 shadow-sm">
                        <div id="cd-seconds" class="text-2xl sm:text-4xl md:text-5xl font-mono font-bold text-blue-500">--</div>
                        <div class="text-xs md:text-sm text-slate-500 mt-1 font-medium">秒 (Secs)</div>
                    </div>
                </div>
                <div class="mt-4 text-xs sm:text-sm text-slate-400">目標日期：2027年2月1日</div>
            </div>
        </div>
    </header>

    <!-- 主要內容區 -->
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">

        <!-- 最新公告區 -->
        <section id="news" class="scroll-mt-24">
            <div class="flex items-center justify-between mb-6 border-b-2 border-teal-100 pb-3">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-bullhorn text-2xl text-amber-500 bg-amber-50 p-2 rounded-lg"></i>
                    <h2 class="text-2xl font-bold text-slate-800">最新公告與提醒</h2>
                </div>
            </div>
            
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <ul class="divide-y divide-slate-100">
                    <li onclick="openModal('【重要】下學期內外科實習梯次志願選填開放', '請各位同學於本週五 (10/5) 中午12:00前完成線上系統志願選填，逾期由系辦代為安排，不得異議。選填前請先詳閱各醫院排班說明檔。')" class="p-5 hover:bg-slate-50 transition flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 cursor-pointer">
                        <div class="flex-shrink-0 flex gap-2 sm:flex-col sm:gap-1 items-start sm:items-center w-24">
                            <span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-red-100 text-red-600 border border-red-200">
                                <i class="fa-solid fa-thumbtack mr-1"></i> 置頂
                            </span>
                            <span class="text-sm font-medium text-slate-500">10/01</span>
                        </div>
                        <div class="flex-grow">
                            <h3 class="text-lg font-bold text-teal-700 mb-1">【重要】下學期內外科實習梯次志願選填開放！</h3>
                            <p class="text-sm text-slate-600">請各位同學於本週五 (10/5) 中午12:00前完成線上系統志願選填...</p>
                        </div>
                        <div class="hidden sm:block text-slate-400">
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>
                    </li>

                    <li onclick="openModal('加冠典禮照片與影片雲端連結已上架', '攝影組已將上週加冠典禮的高畫質照片整理完畢，請至班級 Google Drive 雲端硬碟下載備份。感謝活動組辛苦籌備！')" class="p-5 hover:bg-slate-50 transition flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 cursor-pointer">
                        <div class="flex-shrink-0 flex gap-2 sm:flex-col sm:gap-1 items-start sm:items-center w-24">
                            <span class="inline-flex items-center px-2 py-1 rounded text-xs font-bold bg-blue-100 text-blue-600 border border-blue-200">
                                系辦通知
                            </span>
                            <span class="text-sm font-medium text-slate-500">09/25</span>
                        </div>
                        <div class="flex-grow">
                            <h3 class="text-lg font-bold text-slate-800 mb-1">加冠典禮照片與影片雲端連結已上架</h3>
                            <p class="text-sm text-slate-600">攝影組已將上週加冠典禮的高畫質照片整理完畢，請至班級共用資料夾下載。</p>
                        </div>
                        <div class="hidden sm:block text-slate-400">
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>
                    </li>
                </ul>
            </div>
        </section>

        <!-- 實習專區 (新增：實習醫院搜尋過濾功能) -->
        <section id="internship" class="scroll-mt-24">
            <div class="flex items-center justify-between mb-6 border-b-2 border-emerald-100 pb-3">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-user-nurse text-2xl text-emerald-500 bg-emerald-50 p-2 rounded-lg"></i>
                    <h2 class="text-2xl font-bold text-slate-800">實習專區與單位檢索</h2>
                </div>
            </div>

            <!-- 實習醫院動態搜尋 -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 mb-6 shadow-sm">
                <div class="flex flex-col md:flex-row gap-3">
                    <div class="relative flex-grow">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3.5 text-slate-400"></i>
                        <input type="text" id="hospitalSearch" onkeyup="filterHospitals()" placeholder="搜尋實習醫院名稱或科別（如：臺大、長庚、內科、產科...）" class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-sm">
                    </div>
                </div>
            </div>

            <div id="hospitalContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <div class="hospital-card group bg-white p-6 rounded-2xl shadow-sm hover:shadow-md border border-slate-100 hover:border-emerald-300 transition-all duration-300 flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-emerald-50 group-hover:bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 mb-4 transition-colors">
                        <i class="fa-regular fa-hospital text-3xl"></i>
                    </div>
                    <h3 class="hospital-name text-lg font-bold text-slate-800 mb-1">臺大醫院 - 內科</h3>
                    <p class="hospital-dept text-xs bg-emerald-100 text-emerald-800 px-2.5 py-0.5 rounded-full mb-2">內外科實習</p>
                    <p class="text-xs text-slate-500">常考疾病：COPD, CAD, DM。阿長注重無菌操作與交班架構。</p>
                </div>

                <div class="hospital-card group bg-white p-6 rounded-2xl shadow-sm hover:shadow-md border border-slate-100 hover:border-emerald-300 transition-all duration-300 flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-emerald-50 group-hover:bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 mb-4 transition-colors">
                        <i class="fa-solid fa-baby text-3xl"></i>
                    </div>
                    <h3 class="hospital-name text-lg font-bold text-slate-800 mb-1">林口長庚 - 兒科</h3>
                    <p class="hospital-dept text-xs bg-blue-100 text-blue-800 px-2.5 py-0.5 rounded-full mb-2">兒科實習</p>
                    <p class="text-xs text-slate-500">重點：小兒劑量換算、發燒處理流程與衛教技巧。</p>
                </div>

                <div class="hospital-card group bg-white p-6 rounded-2xl shadow-sm hover:shadow-md border border-slate-100 hover:border-emerald-300 transition-all duration-300 flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-emerald-50 group-hover:bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 mb-4 transition-colors">
                        <i class="fa-solid fa-person-breastfeeding text-3xl"></i>
                    </div>
                    <h3 class="hospital-name text-lg font-bold text-slate-800 mb-1">北榮 - 產房/產後</h3>
                    <p class="hospital-dept text-xs bg-pink-100 text-pink-800 px-2.5 py-0.5 rounded-full mb-2">產科實習</p>
                    <p class="text-xs text-slate-500">重點：NST判讀、宮縮評估、產後出血觀察與母乳哺育。</p>
                </div>

                <div class="hospital-card group bg-white p-6 rounded-2xl shadow-sm hover:shadow-md border border-slate-100 hover:border-emerald-300 transition-all duration-300 flex flex-col items-center text-center">
                    <div class="w-16 h-16 bg-emerald-50 group-hover:bg-emerald-100 rounded-full flex items-center justify-center text-emerald-600 mb-4 transition-colors">
                        <i class="fa-solid fa-brain text-3xl"></i>
                    </div>
                    <h3 class="hospital-name text-lg font-bold text-slate-800 mb-1">市立聯合醫院 - 精神科</h3>
                    <p class="hospital-dept text-xs bg-purple-100 text-purple-800 px-2.5 py-0.5 rounded-full mb-2">精神科實習</p>
                    <p class="text-xs text-slate-500">重點：治療性人際關係建立、精神症狀評估、團體治療。</p>
                </div>
            </div>
        </section>

        <!-- 新功能 1：OSCE 臨床技術考核自主檢核表 -->
        <section id="osce" class="scroll-mt-24">
            <div class="flex items-center justify-between mb-6 border-b-2 border-indigo-100 pb-3">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-list-check text-2xl text-indigo-500 bg-indigo-50 p-2 rounded-lg"></i>
                    <h2 class="text-2xl font-bold text-slate-800">OSCE 技術考自主進度檢核</h2>
                </div>
                <span id="osceProgressText" class="text-sm font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full">已完成 0 / 6 項</span>
            </div>

            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                <!-- 進度條 -->
                <div class="w-full bg-slate-100 rounded-full h-3 mb-6 overflow-hidden">
                    <div id="osceProgressBar" class="bg-indigo-600 h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="osceChecklist">
                    <label class="flex items-center p-3 rounded-xl border border-slate-100 hover:bg-indigo-50/50 cursor-pointer transition">
                        <input type="checkbox" class="osce-item w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 mr-3" onchange="updateOsceProgress()">
                        <span class="text-sm font-medium text-slate-700">給藥技術 (三讀五對、針劑/口服)</span>
                    </label>
                    <label class="flex items-center p-3 rounded-xl border border-slate-100 hover:bg-indigo-50/50 cursor-pointer transition">
                        <input type="checkbox" class="osce-item w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 mr-3" onchange="updateOsceProgress()">
                        <span class="text-sm font-medium text-slate-700">無菌換藥與傷口照護技術</span>
                    </label>
                    <label class="flex items-center p-3 rounded-xl border border-slate-100 hover:bg-indigo-50/50 cursor-pointer transition">
                        <input type="checkbox" class="osce-item w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 mr-3" onchange="updateOsceProgress()">
                        <span class="text-sm font-medium text-slate-700">導尿技術 (單導/留置導尿)</span>
                    </label>
                    <label class="flex items-center p-3 rounded-xl border border-slate-100 hover:bg-indigo-50/50 cursor-pointer transition">
                        <input type="checkbox" class="osce-item w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 mr-3" onchange="updateOsceProgress()">
                        <span class="text-sm font-medium text-slate-700">靜脈留置針穿刺與點滴架設 (IV)</span>
                    </label>
                    <label class="flex items-center p-3 rounded-xl border border-slate-100 hover:bg-indigo-50/50 cursor-pointer transition">
                        <input type="checkbox" class="osce-item w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 mr-3" onchange="updateOsceProgress()">
                        <span class="text-sm font-medium text-slate-700">鼻胃管插管與灌食法 (NG Tube)</span>
                    </label>
                    <label class="flex items-center p-3 rounded-xl border border-slate-100 hover:bg-indigo-50/50 cursor-pointer transition">
                        <input type="checkbox" class="osce-item w-5 h-5 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 mr-3" onchange="updateOsceProgress()">
                        <span class="text-sm font-medium text-slate-700">氣切抽痰與氧氣療法技術</span>
                    </label>
                </div>
            </div>
        </section>

        <!-- 新功能 2：護理站臨床常用醫學術語速查 -->
        <section id="terms" class="scroll-mt-24">
            <div class="flex items-center justify-between mb-6 border-b-2 border-teal-100 pb-3">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-book-medical text-2xl text-teal-500 bg-teal-50 p-2 rounded-lg"></i>
                    <h2 class="text-2xl font-bold text-slate-800">臨床護理醫學縮寫速查卡</h2>
                </div>
            </div>

            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <input type="text" id="termInput" onkeyup="searchTerms()" placeholder="快速搜尋縮寫或中文（例如: QD, NPO, STAT, 禁食...）" class="w-full mb-4 px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-teal-400 text-sm">
                
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" id="termsList">
                    <div class="term-card p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="term-code font-bold text-teal-700 block">QD</span>
                        <span class="term-desc text-xs text-slate-600">每日一次</span>
                    </div>
                    <div class="term-card p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="term-code font-bold text-teal-700 block">BID</span>
                        <span class="term-desc text-xs text-slate-600">每日兩次</span>
                    </div>
                    <div class="term-card p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="term-code font-bold text-teal-700 block">TID</span>
                        <span class="term-desc text-xs text-slate-600">每日三次</span>
                    </div>
                    <div class="term-card p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="term-code font-bold text-teal-700 block">QID</span>
                        <span class="term-desc text-xs text-slate-600">每日四次</span>
                    </div>
                    <div class="term-card p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="term-code font-bold text-teal-700 block">PRN</span>
                        <span class="term-desc text-xs text-slate-600">需要時給予</span>
                    </div>
                    <div class="term-card p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="term-code font-bold text-teal-700 block">STAT</span>
